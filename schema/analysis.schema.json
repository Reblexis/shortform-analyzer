{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/trevkang/shortform-breakdown/schema/analysis.schema.json",
  "title": "Analysis",
  "description": "What shortform-breakdown's analyzeVideo returns (schemaVersion 1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ok",
    "duration",
    "scenes",
    "sections",
    "format",
    "formatProbs",
    "goal",
    "sells",
    "production",
    "voice",
    "transcript"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ok": {
      "const": true
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "$ref": "#/definitions/scene"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/section"
      }
    },
    "format": {
      "type": "string",
      "enum": [
        "meme",
        "skit",
        "product_demo",
        "tutorial",
        "review",
        "storytime",
        "before_after",
        "unboxing",
        "behind_the_scenes",
        "talking_head",
        "other"
      ]
    },
    "formatProbs": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "goal": {
      "type": "string",
      "enum": [
        "conversion",
        "awareness"
      ]
    },
    "sells": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "production": {
      "type": "string",
      "enum": [
        "on_camera_person",
        "screen_recording",
        "hands_only",
        "broll_voiceover",
        "text_only",
        "animation",
        "mixed"
      ]
    },
    "voice": {
      "type": "string",
      "enum": [
        "on_camera_speech",
        "voiceover",
        "none",
        "music_only"
      ]
    },
    "answers": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "transcript": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "transcriptError": {
      "type": "string"
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start",
        "end",
        "thumbnail",
        "transcript",
        "beat",
        "beatProbs",
        "lever",
        "leverProbs",
        "hold"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "cut": {
          "const": false,
          "description": "Present only when the scene continues the take before it"
        },
        "thumbnail": {
          "type": "string",
          "pattern": "^data:image/jpeg;base64,"
        },
        "transcript": {
          "type": "string"
        },
        "beat": {
          "type": "string",
          "enum": [
            "hook",
            "setup",
            "value",
            "proof",
            "payoff",
            "cta"
          ]
        },
        "beatProbs": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "lever": {
          "type": "string",
          "enum": [
            "curiosity",
            "pattern_interrupt",
            "relatable",
            "demonstration",
            "social_proof",
            "emotion",
            "direct_ask",
            "none"
          ]
        },
        "leverProbs": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "textOnScreen": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beat",
        "start",
        "end",
        "scenes",
        "transcript"
      ],
      "properties": {
        "beat": {
          "type": "string",
          "enum": [
            "hook",
            "setup",
            "value",
            "proof",
            "payoff",
            "cta"
          ]
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "transcript": {
          "type": "string"
        }
      }
    }
  }
}
